#!/usr/bin/env node

import cluster from 'node:cluster';

/* Node is single threaded, so a single process only uses one cpu core. With
   FRONTEND_WORKERS > 1 we start multiple server processes that share the same
   port; the primary process accepts connections and distributes them over the
   workers (round-robin), and restarts workers when they exit (e.g. after an
   uncaught exception or a crash). */
const workers = parseInt(process.env.FRONTEND_WORKERS || '1');

if(workers > 1 && cluster.isPrimary){
  console.log(`Starting ${workers} frontend workers`);
  cluster.setupPrimary({exec: new URL('./server.js', import.meta.url).pathname});
  for (let i = 0; i < workers; i++) {
    cluster.fork();
  }
  cluster.on('exit', function(worker, code, signal){
    console.log(`[CLUSTER] worker ${worker.process.pid} exited (code ${code}, signal ${signal}), restarting`);
    //wait a bit to avoid a restart loop when something is broken, e.g. the database is down
    setTimeout(() => cluster.fork(), 1000);
  });
} else {
  await import('./server.js');
}
